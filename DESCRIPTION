Package: SILM
Type: Package
Title: Simultaneous Inference for High-Dimensional Linear Models
Version: 1.0.0.9000
Authors@R: c(
    person("Xianyang", "Zhang", role = c("aut", "cre"),
           email = "zhangxiany@stat.tamu.edu"),
